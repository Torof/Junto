# Supabase — client-safe (anon key, protected by RLS)
# NEVER put service_role key here — see SECURITY.md
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Canonical web host for share links (code falls back to askandgo.io)
EXPO_PUBLIC_JUNTO_WEB_HOST=askandgo.io

# Mapbox
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Mapbox SDK download token (sk., scope DOWNLOADS:READ) — build-time only,
# read by the @rnmapbox/maps plugin at prebuild. Also stored as an EAS
# secret in all three environments.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Google Places
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

